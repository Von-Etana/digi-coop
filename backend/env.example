# Server
NODE_ENV=development
PORT=3000
API_VERSION=v1

# Database - PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/digicoop
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_ACCESS_SECRET=your-super-secret-access-key-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Encryption (AES-256)
ENCRYPTION_KEY=your-32-character-encryption-key!

# Two-Factor Authentication
TOTP_ISSUER=DigiCoop

# SMS Provider (e.g., Termii, Africa's Talking)
SMS_API_KEY=your-sms-api-key
SMS_SENDER_ID=DigiCoop

# Identity Verification (SmileID)
SMILE_ID_API_KEY=your-smile-id-api-key
SMILE_ID_PARTNER_ID=your-partner-id
SMILE_ID_BASE_URL=https://api.smileidentity.com

# Payment Gateway (Flutterwave)
FLUTTERWAVE_PUBLIC_KEY=your-flutterwave-public-key
FLUTTERWAVE_SECRET_KEY=your-flutterwave-secret-key
FLUTTERWAVE_WEBHOOK_SECRET=your-webhook-secret

# Payment Gateway (Paystack) - Alternative
PAYSTACK_PUBLIC_KEY=your-paystack-public-key
PAYSTACK_SECRET_KEY=your-paystack-secret-key

# AWS S3 (for file uploads)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=digicoop-uploads
AWS_REGION=eu-west-1

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug
